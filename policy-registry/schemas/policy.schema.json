{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cifracivica.example/schemas/policy.schema.json",
  "title": "Cifra Civica policy registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "slug", "publicName", "shortDescription", "origin", "taxYear",
    "status", "validationStatus", "territorialScope", "fiscalRegimeScope",
    "effectiveFrom", "effectiveTo", "supersedes", "inheritedBaseline",
    "legalOrProposalSources", "interpretationNotes", "assumptions",
    "parameterSet", "parameterOverrides", "formulaOverrides", "knownLimitations",
    "testCaseIds", "aggregateBenchmarkIds", "reviewedBy", "lastReviewedAt",
    "modelCompatibility", "policyVersion", "publicChangelog", "methodologyPath",
    "published", "isSynthetic", "carryForwardFromTaxYear", "uncertaintyStatus"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "publicName": {"type": "string", "minLength": 5, "maxLength": 160},
    "shortDescription": {"type": "string", "minLength": 20, "maxLength": 500},
    "origin": {"type": "string", "minLength": 3, "maxLength": 160},
    "taxYear": {"type": "integer", "minimum": 2000, "maximum": 2100},
    "status": {
      "enum": ["draft", "proposed", "legislated", "simulated", "validated", "archived"]
    },
    "validationStatus": {
      "enum": ["unreviewed", "source_reviewed", "household_tested", "aggregate_tested", "production_validated"]
    },
    "territorialScope": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9]{2}$"}
    },
    "fiscalRegimeScope": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["common", "foral_navarre", "foral_basque"]}
    },
    "effectiveFrom": {"type": "string", "format": "date"},
    "effectiveTo": {"type": ["string", "null"], "format": "date"},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "inheritedBaseline": {"type": ["string", "null"]},
    "legalOrProposalSources": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^source-[a-z0-9-]+$"}
    },
    "interpretationNotes": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "parameterSet": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "parameterOverrides": {"type": "object"},
    "formulaOverrides": {"type": "object"},
    "knownLimitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "testCaseIds": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "aggregateBenchmarkIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reviewedBy": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "lastReviewedAt": {"type": "string", "format": "date"},
    "modelCompatibility": {"type": "string", "pattern": "^>=?[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "policyVersion": {"type": "string", "minLength": 3, "maxLength": 80},
    "publicChangelog": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["date", "description"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "description": {"type": "string", "minLength": 5}
        }
      }
    },
    "methodologyPath": {"type": "string", "pattern": "^methodology/[a-z0-9-]+\\.md$"},
    "published": {"type": "boolean"},
    "isSynthetic": {"type": "boolean"},
    "carryForwardFromTaxYear": {"type": ["integer", "null"], "minimum": 2000, "maximum": 2100},
    "uncertaintyStatus": {"enum": ["low", "medium", "high", "not_assessed"]}
  }
}

