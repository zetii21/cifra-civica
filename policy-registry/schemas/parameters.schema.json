{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cifracivica.example/schemas/parameters.schema.json",
  "title": "Cifra Civica fiscal parameter set",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "currency", "moneyUnit", "reviewedAt", "referenceTaxYears", "sources", "irpf", "socialSecurity", "benefits"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "version": {"type": "string"},
    "currency": {"const": "EUR"},
    "moneyUnit": {"const": "cent"},
    "reviewedAt": {"type": "string", "format": "date"},
    "referenceTaxYears": {
      "type": "object", "additionalProperties": false,
      "required": ["stateIrpf", "autonomousIrpf", "socialSecurity"],
      "properties": {
        "stateIrpf": {"type": "integer"},
        "autonomousIrpf": {"type": "integer"},
        "socialSecurity": {"type": "integer"}
      }
    },
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^source-"}},
    "irpf": {
      "type": "object",
      "required": ["stateGeneralRateDeltaBasisPoints", "stateGeneralScale", "stateSavingsScale", "autonomousSavingsScale", "autonomousGeneralScales", "minimums", "workIncome", "jointFiling"]
    },
    "socialSecurity": {
      "type": "object", "required": ["employee", "selfEmployed"]
    },
    "benefits": {
      "type": "object", "required": ["annualPerEligibleDescendantCents"]
    }
  }
}

