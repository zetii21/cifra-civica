# Runtime
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_APP_URL=http://localhost:3000
SIMULATION_API_BASE_URL=http://localhost:8000
TILE_PORT=3102

# API privacy and resilience controls
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BYTES=65536
CALCULATION_TIMEOUT_SECONDS=10
ENABLE_CALCULATION_TRACE=false

# Synthetic fixtures are permitted only outside production.
ENABLE_SYNTHETIC_SCENARIOS=true
ALLOW_SYNTHETIC_SCENARIOS_IN_PRODUCTION=false
ALLOW_SYNTHETIC_DATA_IN_PRODUCTION=false

# Build metadata; release automation should set immutable values.
APP_VERSION=0.1.0-dev
MODEL_VERSION=unreleased
POLICY_REGISTRY_COMMIT=working-tree
DATA_PIPELINE_VERSION=unreleased
GEOGRAPHY_VERSION=demo
BUILD_DATE=local

# No analytics, advertising or session replay is enabled by default.
NEXT_TELEMETRY_DISABLED=1
